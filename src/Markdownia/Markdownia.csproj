<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Markdownia</RootNamespace>
    <AssemblyName>Markdownia</AssemblyName>
    <Version>0.1.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>markdownia.ico</ApplicationIcon>
    <Product>Markdownia</Product>
    <Description>A Markdown editor and viewer</Description>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- Native AOT -->
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <!-- The .NET ILCompiler defaults to clang on Linux; fall back to gcc when clang is not installed. -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux')) And !Exists('/usr/bin/clang') And '$(CppCompilerAndLinker)' == ''">
    <CppCompilerAndLinker>gcc</CppCompilerAndLinker>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="CSharpMath.Avalonia" Version="1.0.0-pre.2" />
    <PackageReference Include="Markdig" Version="1.4.1" />
  </ItemGroup>

</Project>
