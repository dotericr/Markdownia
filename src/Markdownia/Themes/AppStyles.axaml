<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Markdownia.Controls">

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="fonts:Inter#Inter" />
  </Style>

  <!-- Ribbon tab headers -->
  <Style Selector="RadioButton.ribbon-tab">
    <Setter Property="Foreground" Value="{DynamicResource Md.ChromeForegroundBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Border" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4,4,0,0">
          <Grid RowDefinitions="*,Auto">
            <TextBlock Name="PART_Text" Text="{TemplateBinding Content}" HorizontalAlignment="Center"
                       Foreground="{TemplateBinding Foreground}" />
            <Border Name="PART_Underline" Grid.Row="1" Height="2.5" CornerRadius="1.25" Margin="2,5,2,-6"
                    Background="{DynamicResource Md.AccentBrush}" IsVisible="False" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.ribbon-tab:pointerover /template/ Border#PART_Border">
    <Setter Property="Background" Value="{DynamicResource Md.ChromeHoverBrush}" />
  </Style>
  <Style Selector="RadioButton.ribbon-tab:checked /template/ Border#PART_Underline">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="RadioButton.ribbon-tab:checked /template/ TextBlock#PART_Text">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- File menu button: accent-colored like Word's File tab -->
  <Style Selector="Button.file-tab">
    <Setter Property="Background" Value="{DynamicResource Md.AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource Md.AccentForegroundBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="14,5" />
    <Setter Property="Margin" Value="6,4,6,4" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Focusable" Value="False" />
  </Style>
  <Style Selector="Button.file-tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Md.AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource Md.AccentForegroundBrush}" />
    <Setter Property="Opacity" Value="0.88" />
  </Style>

  <!-- Compact controls inside the ribbon -->
  <Style Selector="Border.ribbon-body ComboBox">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="8,0,4,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Focusable" Value="False" />
  </Style>
  <Style Selector="Border.ribbon-body TextBlock.ribbon-caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource Md.ChromeMutedBrush}" />
  </Style>
  <Style Selector="Border.ribbon-body TextBlock.ribbon-value">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource Md.ChromeForegroundBrush}" />
    <Setter Property="FontFeatures" Value="tnum" />
  </Style>

  <!-- Gallery tiles (styles + themes) -->
  <Style Selector="Button.gallery">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="Margin" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Focusable" Value="False" />
  </Style>
  <Style Selector="Button.gallery:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Md.ChromeHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Md.ChromeBorderBrush}" />
  </Style>
  <Style Selector="Button.gallery.selected">
    <Setter Property="BorderBrush" Value="{DynamicResource Md.AccentBrush}" />
  </Style>
  <Style Selector="Button.gallery.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Md.AccentBrush}" />
  </Style>

  <!-- Status bar -->
  <Style Selector="Border.status-bar TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource Md.ChromeMutedBrush}" />
    <Setter Property="FontFeatures" Value="tnum" />
  </Style>
  <Style Selector="Border.status-bar Slider">
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <!-- Code block copy button in the preview -->
  <Style Selector="Button.code-copy">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>

  <!-- Pane splitter -->
  <Style Selector="GridSplitter.pane-splitter">
    <Setter Property="Background" Value="{DynamicResource Md.ChromeBorderBrush}" />
    <Setter Property="MinWidth" Value="1" />
    <Setter Property="Width" Value="1" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="Transparent" Margin="-3,0">
          <Border Background="{TemplateBinding Background}" Width="1" HorizontalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="MenuItem">
    <Setter Property="FontSize" Value="13" />
  </Style>
</Styles>
